# ============================================================
# hh-smart-hunter: все настройки через переменные окружения.
# Вложенные секции разделяются "__" (двойное подчёркивание).
# Префикс: HHSH_
# Скопируйте файл: cp .env.example .env
# ============================================================

# ---------- Приложение ----------
HHSH_APP__LOG_LEVEL=INFO
HHSH_APP__TIMEZONE=Europe/Moscow
HHSH_APP__DATA_DIR=data
HHSH_APP__CONFIG_DIR=config

# ---------- База данных ----------
# SQLite (по умолчанию) или PostgreSQL: postgresql+asyncpg://user:pass@host:5432/hh
HHSH_DB__URL=sqlite+aiosqlite:////app/runtime/hh-smart-hunter.db

# ---------- LLM (OpenAI-совместимый роутер) ----------
# OpenRouter / LiteLLM / Ollama (http://localhost:11434/v1) / любой совместимый прокси
HHSH_LLM__BASE_URL=https://openrouter.ai/api/v1
HHSH_LLM__API_KEY=sk-or-...
HHSH_LLM__MODEL=anthropic/claude-sonnet-4.6
HHSH_LLM__TEMPERATURE=0.3
HHSH_LLM__MAX_TOKENS=1600
HHSH_LLM__REQUESTS_PER_MINUTE=20

# ---------- Telegram ----------
# Токен бота, созданного через @BotFather (человек-в-контуре: все отклики подтверждаются кнопками)
HHSH_TELEGRAM__BOT_TOKEN=123456:AA...
# ID вашего личного чата (узнать: https://t.me/userinfobot)
HHSH_TELEGRAM__CHAT_ID=0

# ---------- Адаптер hh.ru (hh-agent) ----------
# MOCK=true — вся система работает на тестовых данных без hh.ru и браузера
HHSH_HH__MOCK=true
# hh-agent — демон-парсер на хосте с Chrome; адрес его /call-эндпоинта
# (через ssh-туннель: localhost-порт туннеля)
HHSH_HH__AGENT_ENDPOINT=http://127.0.0.1:10087
# Имя webbridge-сессии (группа вкладок hh.ru)
HHSH_HH__SESSION=hhru
HHSH_HH__COMMAND_TIMEOUT_SECONDS=90
# Один браузер — не больше двух параллельных обращений
HHSH_HH__MAX_CONCURRENCY=2

# ---------- Планировщик ----------
HHSH_SCHEDULER__POLL_INTERVAL_MINUTES=30
HHSH_SCHEDULER__STATUS_CHECK_INTERVAL_MINUTES=90
# Дежурный интервал автоподнятия задаётся в config/filters.yaml (section: boost),
# лимит HHSH ниже — защита от rate-limit hh.ru
HHSH_SCHEDULER__MINUTES_BETWEEN_BOOSTS=240

# ---------- Скоринг ----------
HHSH_SCORING__SCORE_THRESHOLD=7
HHSH_SCORING__RESUME_PATH=data/resume.md
HHSH_SCORING__FILTERS_PATH=config/filters.yaml
HHSH_SCORING__PROMPTS_DIR=prompts